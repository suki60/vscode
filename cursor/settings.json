{
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "biome.enabled": false,
  "bookmarks.sideBar.countBadge": "off",
  "cursor.cpp.enablePartialAccepts": true,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {},
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.dragAndDrop": false,
  "editor.fontFamily": "Roboto Mono",
  "editor.fontSize": 15,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.suggest.filterGraceful": false,
  "editor.suggest.showWords": false,
  "editor.tabSize": 2,
  "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
  "explorer.autoReveal": "focusNoScroll",
  "extensions.ignoreRecommendations": true,
  "files.exclude": {
    "": true,
    "**/.git": true
  },
  "git-graph.repository.showRemoteBranches": false,
  "git.allowForcePush": true,
  "git.allowNoVerifyCommit": true,
  "git.confirmNoVerifyCommit": false,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.showReferenceDetails": false,
  "git.suggestSmartCommit": false,
  "gitblame.statusBarMessageFormat": "${author.name} (${time.ago})",
  "gitHistory.showFileHistorySplit": false,
  "githubPullRequests.createOnPublishBranch": "never",
  "githubPullRequests.pullBranch": "never",
  "javascript.format.semicolons": "remove",
  "javascript.preferGoToSourceDefinition": true,
  "prettier.semi": false,
  "problems.decorations.enabled": false,
  "search.quickOpen.includeHistory": false,
  "search.smartCase": true,
  "search.useParentIgnoreFiles": true,
  "security.promptForLocalFileProtocolHandling": false,
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "args": ["-l", "-i"],
      "path": "/bin/zsh"
    }
  },
  "terminal.integrated.shellIntegration.enabled": false,
  "typescript.format.semicolons": "remove",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "typescript.preferGoToSourceDefinition": true,
  "typescriptExplorer.typeTree.view.icons.colors.enable": false,
  "typescriptExplorer.typeTree.view.icons.enable": false,
  "update.showReleaseNotes": false,
  "window.commandCenter": false,
  "window.confirmSaveUntitledWorkspace": false,
  "workbench.activityBar.location": "top",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.colorTheme": "Atom One Dark",
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.focusRecentEditorAfterClose": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.preventPinnedEditorClose": "never",
  "workbench.iconTheme": "file-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "zenMode.fullScreen": false
}
