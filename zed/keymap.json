// Zed keymap — ported from vscode/keybindings.json
//
// Only bindings with a real Zed equivalent are kept. Anything that depended on a
// VS Code extension with no Zed counterpart is listed at the bottom of this file.
// settings.json sets "base_keymap": "VSCode", so unlisted VS Code defaults still apply.
[
  // workbench
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-a": "workspace::ToggleLeftDock",
      "cmd-shift-\\": "workspace::ToggleRightDock",
      "ctrl-alt-cmd-\\": "workspace::ToggleZoom",
      "cmd-shift-e": "project_panel::ToggleFocus",
      "cmd-shift-y": "outline_panel::ToggleFocus",
      "cmd-shift-d": "debug_panel::ToggleFocus",
      "cmd-shift-x": "zed::Extensions",
      "cmd-shift-s": "git_panel::ToggleFocus",
      "cmd-shift-/": "agent::ToggleFocus",
      "ctrl-alt-cmd-/": "editor::ToggleEditPrediction",
      "cmd-shift-;": "agent::OpenAgentDiff",
      "cmd-shift-space": "workspace::ToggleBottomDock",
      "ctrl-alt-cmd-up": "workspace::ToggleZoom",
      "cmd-shift-1": "diagnostics::Deploy",
      "cmd-shift-2": "zed::OpenLog",
      "cmd-shift-4": "terminal_panel::ToggleFocus",
      "cmd-shift-k": "zed::OpenKeymap",
      "ctrl-alt-cmd-k": "zed::OpenKeymapFile",
      "cmd-shift-,": "zed::OpenSettings",
      "ctrl-alt-cmd-,": "zed::OpenSettingsFile",
      "cmd-shift-h": "pane::DeploySearch",
      "cmd-shift-m": "workspace::ToggleCenteredLayout",
      "cmd-shift-i": "git_panel::ActivateHistoryTab",
      "cmd-shift-o": "workspace::Open",
      "ctrl-alt-cmd-o": "git::OpenModifiedFiles",
      "cmd-shift-w": "workspace::CloseAllItemsAndPanes",
      "cmd-shift-backspace": "git::RestoreTrackedFiles",
      "ctrl-alt-cmd-n": "workspace::NewWindow",
      "ctrl-alt-cmd-w": "workspace::CloseWindow",
      "ctrl-alt-cmd-l": "workspace::Reload",
      "cmd-shift-]": ["workspace::MoveItemToPane", { "destination": 1 }],
      "cmd-shift-[": ["workspace::MoveItemToPane", { "destination": 0 }],
      "cmd-t": "file_finder::Toggle",
      "cmd-l": "language_selector::Toggle",
      "ctrl-tab": "tab_switcher::Toggle",
      "ctrl-p": "workspace::CopyRelativePath",
      "ctrl-b": "git::CopyBranchName",
      // agents
      "cmd-`": "agent::NewThread",
      "alt-=": "agent::AddSelectionToThread",
      "shift-alt-=": "agent::OpenAddContextMenu",
    },
  },
  // git — cmd-g chords
  {
    "context": "Workspace",
    "bindings": {
      "cmd-g cmd-shift-f": "git::Fetch",
      "cmd-g cmd-shift-p": "git::Pull",
      "cmd-g ctrl-alt-cmd-p": "git::PullRebase",
      "cmd-g cmd-shift-u": "git::Push",
      "cmd-g ctrl-alt-cmd-u": "git::ForcePush",
      "cmd-g cmd-shift-c": "git::Switch",
      "cmd-g cmd-shift-b": "git::Branch",
      "cmd-g cmd-shift-n": "git::RenameBranch",
      "cmd-g cmd-shift-enter": "git::Commit",
      "cmd-g cmd-shift-,": "git::Uncommit",
      "cmd-g cmd-shift-s": "git::StashAll",
      "cmd-g cmd-shift-o": "git::ApplyCurrentStash",
      "cmd-g ctrl-alt-cmd-o": "git::PopCurrentStash",
      "cmd-g ctrl-alt-cmd-d": "git::DropCurrentStash",
      "cmd-g cmd-h": "git::Blame",
      "cmd-g ctrl-alt-cmd-h": "git_panel::ActivateHistoryTab",
      "cmd-g cmd-enter": "git::StageAll",
      "cmd-g cmd-backspace": "git::UnstageAll",
      "cmd-g cmd-shift-backspace": "git::RestoreTrackedFiles",
      "cmd-g cmd-shift-r": "git::CreatePullRequest",
    },
  },
  // editor tabs / panes
  {
    "context": "Pane",
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": ["pane::ActivateItem", 8],
      "ctrl-right": "pane::ActivateNextItem",
      "ctrl-left": "pane::ActivatePreviousItem",
      "cmd-[": "pane::SwapItemLeft",
      "cmd-]": "pane::SwapItemRight",
      "cmd-\\": "pane::TogglePreviewTab",
      "ctrl-\\": "pane::TogglePinTab",
      "ctrl-t": "pane::CloseOtherItems",
      "ctrl-=": "pane::GoForward",
      "ctrl--": "pane::GoBack",
    },
  },
  // editor actions
  {
    "context": "Editor",
    "bindings": {
      "cmd-f": "buffer_search::Deploy",
      "cmd-i": "git::Diff",
      "cmd-r": "editor::FindAllReferences",
      "cmd-p": "editor::Format",
      "cmd-b": "editor::ToggleBookmark",
      "cmd-;": "editor::GoToDefinition",
      "cmd-y": "editor::GoToTypeDefinition",
      "cmd-=": "editor::GoToDiagnostic",
      "cmd--": "editor::GoToPreviousDiagnostic",
      "cmd-shift-.": "editor::ToggleCodeActions",
      "ctrl-i": "editor::OrganizeImports",
      "ctrl-up": "editor::AddSelectionAbove",
      "ctrl-down": "editor::AddSelectionBelow",
      "ctrl-f": "editor::RevealInFileManager",
      "ctrl-c": "editor::CopyFileNameWithoutExtension",
      "ctrl-x": "editor::CopyFileName",
      // text transforms
      "ctrl-l": "editor::ConvertToLowerCase",
      "ctrl-u": "editor::ConvertToUpperCase",
      "ctrl-s": "editor::ConvertToSnakeCase",
      "ctrl-k": "editor::ConvertToKebabCase",
      "ctrl-m": "editor::ConvertToLowerCamelCase",
      "ctrl-a": "editor::ConvertToUpperCamelCase",
      "ctrl-shift-m": "editor::ConvertToTitleCase",
      // selection / lines
      "alt-\\": "editor::SelectLargerSyntaxNode",
      "alt-'": "editor::SelectInsideDelimiters",
      "alt-`": "editor::SelectInsideDelimiters",
      "alt-9": "editor::SelectInsideDelimiters",
      "alt-[": "editor::SelectInsideDelimiters",
      "shift-alt-[": "editor::SelectInsideDelimiters",
      "shift-alt-backspace": "editor::DeleteLine",
      "alt-enter": "editor::NewlineBelow",
      "shift-alt-enter": "editor::NewlineAbove",
      // edit predictions
      "ctrl-/": "editor::ToggleEditPrediction",
      "alt-.": "editor::AcceptNextWordEditPrediction",
      "shift-alt-.": "editor::AcceptNextLineEditPrediction",
    },
  },
  // text snippets — Zed can't bind snippets with tabstops to a key, so these
  // send the literal keystrokes instead and rely on autoclose for the closers.
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-c": ["workspace::SendKeystrokes", "c o n s t space"],
      "alt-e": ["workspace::SendKeystrokes", "l e t space"],
      "alt-y": ["workspace::SendKeystrokes", "t y p e space"],
      "alt-r": ["workspace::SendKeystrokes", "r e t u r n space"],
      "alt-x": ["workspace::SendKeystrokes", "e x p o r t space"],
      "alt-f": ["workspace::SendKeystrokes", "f u n c t i o n space"],
      "alt-i": ["workspace::SendKeystrokes", "i f space ("],
      "alt-l": ["workspace::SendKeystrokes", "c o n s o l e . l o g ("],
      "alt-u": ["workspace::SendKeystrokes", "' u s e space c l i e n t"],
      "shift-alt-u": ["workspace::SendKeystrokes", "' u s e space s e r v e r"],
      "shift-space": ["workspace::SendKeystrokes", "space"],
    },
  },
  // suggestions
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "enter": "editor::ConfirmCompletion",
    },
  },
  // snippet tabstops
  {
    "context": "Editor && in_snippet && has_next_tabstop",
    "bindings": {
      "alt-tab": "editor::NextSnippetTabstop",
    },
  },
  {
    "context": "Editor && in_snippet && has_previous_tabstop",
    "bindings": {
      "shift-alt-tab": "editor::PreviousSnippetTabstop",
    },
  },
  // docks
  {
    "context": "Dock",
    "bindings": {
      "escape": "workspace::FocusCenterPane",
    },
  },
  // explorer
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "cmd-f": "project_panel::NewSearchInDirectory",
      "cmd-shift-c": "project_panel::CollapseAllEntries",
    },
  },
  // find widget
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-r": "search::ToggleReplace",
    },
  },
  // search
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "cmd-i": "project_search::ToggleFilters",
    },
  },
  // scm
  {
    "context": "GitPanel && ChangesList",
    "bindings": {
      "cmd-enter": "git::ToggleStaged",
      "cmd-backspace": ["git::RestoreFile", { "skip_prompt": true }],
      "cmd-shift-backspace": ["git::RestoreFile", { "skip_prompt": false }],
      "ctrl-alt-cmd-enter": "git::Commit",
    },
  },
  // diff editor
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "cmd-=": "editor::GoToHunk",
      "cmd--": "editor::GoToPreviousHunk",
      "cmd-enter": "git::StageRange",
    },
  },
]
// Dropped — no Zed equivalent:
//   shift+cmd+l  test explorer            shift+cmd+r  references view panel
//   shift+cmd+v  targetsContainers        shift+cmd+g  github pull requests
//   shift+cmd+j  jira                     shift+cmd+u  pr status
//   shift+cmd+3  debug repl               shift+cmd+5  playwright locators
//   ctrl+alt+cmd+t  close all + reopen    cmd+j  call hierarchy
//   cmd+e  eslint autofix                 cmd+u  remove unused imports
//   cmd+o  git.openFile                   alt+-  deleteInsideWord
//   ctrl+[ / ctrl+'  bracketeer change    shift+alt+' / shift+alt+]  bracketeer remove
//   alt+a / alt+o / alt+w / alt+, snippets (need tabstops)
//   git: merge, rebase, deleteBranch, commitNoVerify, refresh
//   git.createWorktree/deleteWorktree — Zed's git::CreateWorktree/SwitchWorktree
//   need a branch_target/path argument that only a picker can supply, so no
//   static keybinding is possible
